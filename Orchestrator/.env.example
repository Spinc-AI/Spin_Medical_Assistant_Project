# Where the module APIs are reachable (STT, Core_LLM, and Orchestrator are co-located)
STT_URL=http://localhost:8000
LLM_URL=http://localhost:8001

# This orchestrator's own address
HOST=0.0.0.0
PORT=9000

# How long (seconds) to wait on each call to STT/Core_LLM/an external API.
HTTP_TIMEOUT=600

# External (OpenAI-compatible) API — only relevant if a pipeline's own code
# chooses an "openai:<model>" model for itself (see module_clients.py).
# Never something an orchestrator API caller can select.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
