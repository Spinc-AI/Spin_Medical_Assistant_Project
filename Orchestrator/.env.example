# Where the module APIs are reachable (STT, LLM, and Orchestrator are co-located)
STT_URL=http://localhost:8000
LLM_URL=http://localhost:8001

# This orchestrator's own address
HOST=0.0.0.0
PORT=9000

# Folder holding instruction definitions (default: ./instruction)
# INSTRUCTIONS_DIR=./instruction

# External (OpenAI-compatible) API — used whenever a stt_model/llm_model or an
# stt_slots entry is prefixed "openai:" (e.g. "openai:gpt-4o-mini"), including
# any cloud STT slots in multi-STT instructions (e.g. 02_radiology_report_assist_stt).
#
# These are OPTIONAL — only a fallback default. The normal way to supply
# credentials is per-request: stt_api_key/stt_base_url and llm_api_key/
# llm_base_url in POST /session or /run — STT and LLM external calls are
# independent, so they can use different providers/accounts. Only set these
# if you want a shared default so callers don't have to send their own.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_STT_MODEL=whisper-1
