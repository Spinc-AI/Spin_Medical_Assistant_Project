# Copy this file to ".env" and adjust as needed.

# --- Core_LLM ---------------------------------------------------------------
# AI_Service never loads a model itself; it calls Core_LLM's POST /chat.
#
# Prefer 127.0.0.1 over "localhost" for a Core_LLM on this machine: Core_LLM
# binds 0.0.0.0:8001 (IPv4 only), but "localhost" resolves to ::1 first on
# Windows and the refused IPv6 attempt costs ~2s per call before the client
# falls back to IPv4. Use a hostname only for a genuinely remote Core_LLM.
CORE_LLM_URL=http://127.0.0.1:8001

# Seconds to wait on a Core_LLM call. The first request after a model switch
# also pays the model-load cost, so keep this generous (same reasoning as
# Orchestrator's HTTP_TIMEOUT).
HTTP_TIMEOUT=600

# --- This service -----------------------------------------------------------
# 8000 = STT, 8001 = Core_LLM, 9000 = Orchestrator, 9100 = here.
HOST=0.0.0.0
PORT=9100
# ALLOWED_ORIGINS=*

# --- Versioned behaviour ----------------------------------------------------
# Stamped onto every response and every evaluation result, so a result can be
# traced back to exactly the behaviour that produced it.
ROUTING_POLICY_VERSION=v1
PROMPT_VERSION=v1
# Few-shot examples can be pinned separately from the system prompt
# ("same instructions, different examples" is its own A/B arm).
# FEWSHOT_VERSION=v1
SAFETY_VERSION=v1

# Set false to bypass domain detection and pin every conversation to the
# default domain/model — useful as an A/B control, and as a kill switch.
ROUTER_ENABLED=true

# --- Models -----------------------------------------------------------------
# A registry key from Core_LLM's GET /models.
DEFAULT_MODEL_KEY=gemma-4-12b

# LICENSING — CONFIRM BEFORE CLINICAL/COMMERCIAL GO-LIVE.
# Aya Expanse (aya-expanse-8b/32b) is CC-BY-NC, i.e. non-commercial. While
# this is false the router will not select those models at all. Set it true
# only for research/internal evaluation, and only with sign-off from whoever
# owns licensing for this project.
ALLOW_NON_COMMERCIAL_MODELS=false

# --- Generation -------------------------------------------------------------
# Low by default: a triage interview wants consistency, not creativity.
# TEMPERATURE=0.3
# MAX_TOKENS=512

# --- Limits -----------------------------------------------------------------
# MAX_INPUT_CHARS=4000
# MAX_OUTPUT_CHARS=8000
# MAX_QUESTION_CHARS=600
# In-memory conversations kept before the oldest is evicted.
# MAX_SESSIONS=1000
