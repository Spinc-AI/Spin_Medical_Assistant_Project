# Copy this file to ".env" and adjust as needed.
#
# When you open an SSH tunnel to the 3090 server (see SERVER_SETUP.md),
# the server's Ollama looks like it's running on your own machine, so this
# default works for BOTH local testing and the real server — no code change.
LLM_BASE_URL=http://localhost:11434/v1

# Ollama ignores the key, but the openai SDK requires a non-empty string.
LLM_API_KEY=ollama

# Model tag as pulled by Ollama on the server.
LLM_MODEL=aya-expanse
