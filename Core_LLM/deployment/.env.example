# Copy this file to ".env" and adjust as needed.
#
# All models are served locally via transformers (see model.py) -- no Ollama,
# no external API. Override any Hugging Face model ID below if you want a
# different checkpoint; otherwise the defaults in config.py are used.
#
# AYA_8B_MODEL_ID=CohereLabs/aya-expanse-8b
# AYA_32B_MODEL_ID=CohereLabs/aya-expanse-32b
# GEMMA_31B_MODEL_ID=google/gemma-4-31B-it
# GEMMA_E4B_MODEL_ID=google/gemma-4-E4B-it
# GEMMA_12B_MODEL_ID=google/gemma-4-12B-it
# QWEN_OMNI_MODEL_ID=Qwen/Qwen3-Omni-30B-A3B-Instruct

# Which registry key /chat and /chat_audio fall back to when a request
# doesn't specify "model" explicitly.
DEFAULT_MODEL=aya-expanse-8b

# Max tokens generated per reply.
# MAX_NEW_TOKENS=2048
